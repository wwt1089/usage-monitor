{
  "swagger": "2.0",
  "info": {
    "title": "Claude Admin",
    "description": "Claude Enterprise 조직의 멤버·초대 관리(Admin API)와 사용 현황(Analytics API). 모든 요청에 anthropic-version 헤더가 필요하므로 커넥터 정책(헤더 설정)으로 추가한다.",
    "version": "0.1"
  },
  "host": "api.anthropic.com",
  "basePath": "/v1/organizations",
  "schemes": [
    "https"
  ],
  "consumes": [
    "application/json"
  ],
  "produces": [
    "application/json"
  ],
  "securityDefinitions": {
    "api_key": {
      "type": "apiKey",
      "in": "header",
      "name": "x-api-key"
    }
  },
  "security": [
    {
      "api_key": []
    }
  ],
  "paths": {
    "/users": {
      "get": {
        "operationId": "ListUsers",
        "summary": "멤버 목록",
        "description": "멤버 목록",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "한 번에 받을 개수 (1-1000, 기본 20)"
          },
          {
            "name": "after_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "이 ID 다음부터 (앞 응답의 last_id)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/users/{user_id}": {
      "delete": {
        "operationId": "DeleteUser",
        "summary": "멤버 제거",
        "description": "조직에서 멤버를 제거한다. SCIM 으로 멤버를 관리하는 조직에서는 400 으로 거절된다.",
        "parameters": [
          {
            "name": "user_id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "제거할 멤버 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/invites": {
      "get": {
        "operationId": "ListInvites",
        "summary": "초대 목록",
        "description": "초대 목록",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "한 번에 받을 개수 (1-1000, 기본 20)"
          },
          {
            "name": "after_id",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "이 ID 다음부터 (앞 응답의 last_id)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      },
      "post": {
        "operationId": "CreateInvite",
        "summary": "초대 만들기",
        "description": "초대는 좌석을 하나 차지한다. JIT·SCIM 으로 자동 등록하는 조직에서는 400 으로 거절된다.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "required": true,
            "schema": {
              "type": "object",
              "required": [
                "email",
                "role"
              ],
              "properties": {
                "email": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": [
                    "user",
                    "managed"
                  ]
                }
              }
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/invites/{invite_id}": {
      "delete": {
        "operationId": "DeleteInvite",
        "summary": "초대 취소",
        "description": "대기 중(pending)인 초대만 취소할 수 있다.",
        "parameters": [
          {
            "name": "invite_id",
            "in": "path",
            "type": "string",
            "required": true,
            "description": "취소할 초대 ID"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/analytics/users": {
      "get": {
        "operationId": "ListUserActivity",
        "summary": "사용자별 사용 현황",
        "description": "기간 안의 사용자별 활동과 마지막 사용일(last_activity_date). 키에 read:analytics 범위가 필요하다.",
        "parameters": [
          {
            "name": "starting_date",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "시작일 (UTC, YYYY-MM-DD)"
          },
          {
            "name": "ending_date",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "종료일 (UTC, YYYY-MM-DD, 이 날은 포함하지 않음. 시작일에서 366일 이내)"
          },
          {
            "name": "limit",
            "in": "query",
            "type": "integer",
            "required": false,
            "description": "한 번에 받을 개수 (1-1000, 기본 100)"
          },
          {
            "name": "page",
            "in": "query",
            "type": "string",
            "required": false,
            "description": "다음 쪽 커서 (앞 응답의 next_page)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    },
    "/analytics/summaries": {
      "get": {
        "operationId": "ListActivitySummaries",
        "summary": "일별 요약과 좌석 수",
        "description": "일별 활성 사용자 수와 할당 좌석 수(assigned_seat_count).",
        "parameters": [
          {
            "name": "starting_date",
            "in": "query",
            "type": "string",
            "required": true,
            "description": "시작일 (UTC, YYYY-MM-DD)"
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "schema": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
